# ---- Copy this file to .env and fill in real values before running ----

ENVIRONMENT=dev                     # dev | staging | prod

# --- Database ---
DATABASE_URL=postgresql+asyncpg://santibet_app:changeme@localhost:5432/santibet_dev
DATABASE_URL_TEST=postgresql+asyncpg://santibet_app:changeme@localhost:5432/santibet_test

# --- Redis (cache, pubsub, celery broker, rate limiting) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# --- Feature flags ---
# false = paper-trading/demo mode. Deposits/withdrawals credit a virtual balance
# directly instead of calling a real payment processor. Flip to true only after
# legal/compliance review for your jurisdiction (see backend plan doc, Section 1).
PLATFORM_REAL_MONEY_ENABLED=false

# --- Platform trading defaults ---
DEFAULT_AMM_LIQUIDITY_PARAM=100
TAKER_FEE_BPS=100                    # 100 bps = 1%

# --- OpenAI (AI recommendations + market generation) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Stripe (real-money deposits/withdrawals; optional in demo mode) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- External signal providers (optional, used by the AI signal collector) ---
NEWSAPI_KEY=
FRED_API_KEY=

# --- Misc ---
LOG_LEVEL=INFO
GEOFENCE_BLOCKED_REGIONS=            # comma-separated region codes, e.g. US-NY
